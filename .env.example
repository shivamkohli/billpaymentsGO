# ── Merchant-facing auth (Basic Auth: curl -u KEY_ID:KEY_SECRET) ──────────────
# These are the credentials merchant partners use to call THIS service.
RZP_BILLPAY_KEY_ID=rzp_test_billpay_key
RZP_BILLPAY_KEY_SECRET=rzp_test_billpay_secret

# ── BBPS downstream credentials (NOT yet issued) ──────────────────────────────
# BBPS_MODE controls which BbpcuClient implementation is wired up:
#   mock    -> MockBbpcuClient (deterministic fake NBBL/BBPCU responses, default)
#   staging -> StagingSandboxBbpcuClient (real calls to Razorpay's BBPS sandbox;
#              needs BBPS_STAGING_* below — issued per-merchant at sandbox
#              onboarding, not self-serve. Only one biller is servable this
#              way: SBOX00000NATDF / biller_SBOXSANDBOX001.)
#   live    -> NpciHttpBbpcuClient (real signed-XML calls to BBPCU over mTLS)
# Flip this to "live" the moment the fields below are populated — no code
# changes required, see src/gateway/index.ts.
BBPS_MODE=mock

# ── Razorpay BBPS sandbox (stage) credentials — required for BBPS_MODE=staging ─
BBPS_STAGING_KEY_ID=
BBPS_STAGING_KEY_SECRET=
BBPS_STAGING_BASE_URL=https://api-web.ext.dev.razorpay.in/v1/bill_payments

# Identity NPCI/BBPCU assigns to Razorpay's COU during on-boarding.
BBPS_ORIG_INST=          # e.g. OU21 (2 alpha + 2 numeric)
BBPS_BBPOU_ID=           # Customer BBPOU ID used inside generated IDs

# BBPCU endpoint base URL + auth material (exact shape TBD by NPCI/BBPCU
# on-boarding docs — this is intentionally generic so it can be filled in
# without touching src/gateway/NpciHttpBbpcuClient.ts).
BBPCU_BASE_URL=
BBPS_API_KEY=
BBPS_API_SECRET=

# mTLS / XML-signing material (paths to PEM files) — required for BBPS_MODE=live
BBPS_SIGNING_CERT_PATH=
BBPS_SIGNING_KEY_PATH=
BBPS_MTLS_CA_PATH=

PORT=4000
